# PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/db_genius
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# AES-256 encryption key (32 characters)
DB_GENIUS_ENCRYPT_KEY=your-32-character-secret-key!!!!

# File upload directory
DB_GENIUS_FILE_DIR=/tmp/db-genius/uploads

# Trial mode (public demo)
DB_GENIUS_TRIAL_ENABLED=false
DB_GENIUS_TRIAL_BUILTIN_HOST=
DB_GENIUS_TRIAL_BUILTIN_PORT=3306
DB_GENIUS_TRIAL_BUILTIN_DB_NAME=db-genius
DB_GENIUS_TRIAL_BUILTIN_USERNAME=
DB_GENIUS_TRIAL_BUILTIN_PASSWORD=
