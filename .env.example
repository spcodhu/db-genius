# PostgreSQL connection
# 注意：必须使用 currentSchema=app，因为表都建在 app schema 下
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/db_genius?currentSchema=app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Server port
SERVER_PORT=8109

# AI 模型默认配置（当用户未配置自己的模型时，使用此系统级兜底配置）
DB_GENIUS_DEFAULT_MODEL_API_KEY=sk-your-api-key
DB_GENIUS_DEFAULT_MODEL_BASE_URL=https://api.deepseek.com
DB_GENIUS_DEFAULT_MODEL=deepseek-v4-pro

# AES-256 encryption key (32 characters)
DB_GENIUS_ENCRYPT_KEY=your-32-character-secret-key!!!!

# Aliyun OSS (file upload storage, required)
# RAM 子账号最小授权：该 bucket 的读写 + OCR 调用
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# OSS 对象 key 统一前缀（可选，默认 uploads/）
ALIYUN_OSS_DIR_PREFIX=uploads/

# Aliyun OCR (image text recognition, optional, default disabled)
ALIYUN_OCR_ENABLED=false
# OCR endpoint（可选，默认 ocr-api.cn-hangzhou.aliyuncs.com）
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# Trial mode (public demo)
DB_GENIUS_TRIAL_ENABLED=false
DB_GENIUS_TRIAL_BUILTIN_HOST=
DB_GENIUS_TRIAL_BUILTIN_PORT=3306
DB_GENIUS_TRIAL_BUILTIN_DB_NAME=db-genius
DB_GENIUS_TRIAL_BUILTIN_USERNAME=
DB_GENIUS_TRIAL_BUILTIN_PASSWORD=

# RabbitMQ (async db-config verify & doc generation)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# 工具输出超长拦截（始终生效，可不配置，以下为默认值）
# 单条工具结果超过 max-chars 即做结构感知截断，完整原文存入 per-task 制品仓，
# 模型可用 readToolOutput(artifactId, offset, limit) 分页取回
DB_GENIUS_TOOL_OUTPUT_MAX_CHARS=4000
DB_GENIUS_TOOL_OUTPUT_MAX_ROWS=50
# 按工具名覆盖上限，形如 compareDatabases=8000,readFile=6000（可选）
DB_GENIUS_TOOL_OUTPUT_PER_TOOL_MAX_CHARS=
DB_GENIUS_TOOL_ARTIFACT_TTL_MINUTES=30
DB_GENIUS_TOOL_ARTIFACT_MAX_PER_TASK=20

# 单条数据库语句执行超时（秒）：JDBC setQueryTimeout / MongoDB maxTimeMS
DB_GENIUS_SQL_TIMEOUT_SECONDS=30

# 单轮内上下文瘦身（阶梯式，可不配置，以下为默认值）
# Tier-1 确定性观测遮蔽：零 LLM 调用、零额外时延，默认主力
DB_GENIUS_IN_RUN_ELIDE_ENABLED=true
DB_GENIUS_IN_RUN_ELIDE_THRESHOLD=0.6
DB_GENIUS_IN_RUN_ELIDE_KEEP_LAST_STEPS=3
# Tier-3 LLM 摘要兜底：多付一次全量 prompt 的费用与秒级等待，仅在遮蔽后仍逼近窗口时触发
DB_GENIUS_IN_RUN_SUMMARIZE_ENABLED=true
DB_GENIUS_IN_RUN_SUMMARIZE_THRESHOLD=0.8
DB_GENIUS_IN_RUN_SUMMARIZE_KEEP_LAST_STEPS=4
# Tier-2 陈旧 reasoning 丢弃：收益很大但各供应商容忍度不一（可能 400），默认关闭，灰度验证后再打开
DB_GENIUS_IN_RUN_DROP_STALE_REASONING=false

# 死循环护栏：同一 (工具名 + 参数) 反复调用时拦截；超过硬停阈值即收敛 maxSteps 优雅收尾
DB_GENIUS_LOOP_REPEAT_THRESHOLD=3
DB_GENIUS_LOOP_HARD_STOP_REPEAT=5
DB_GENIUS_LOOP_TRUNCATION_HINT=3
